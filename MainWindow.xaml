<Window x:Class="WpfHmiSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHmiSystem"
        mc:Ignorable="d"
        Title="工控上位机系统" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="LightBlue" Padding="10">
            <TextBlock Text="工控上位机系统" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
        
        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧控制面板 -->
            <StackPanel Grid.Column="0" Margin="5">
                <GroupBox Header="设备连接" Margin="5">
                    <StackPanel Margin="5">
                        <Button x:Name="btnConnect" Content="连接设备" Margin="5" Padding="5"/>
                        <Button x:Name="btnDisconnect" Content="断开连接" Margin="5" Padding="5"/>
                        <TextBlock Text="连接状态：" Margin="5"/>
                        <TextBlock x:Name="tbConnectionStatus" Text="未连接" Margin="5" Foreground="Red"/>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="系统控制" Margin="5">
                    <StackPanel Margin="5">
                        <Button x:Name="btnStart" Content="启动系统" Margin="5" Padding="5"/>
                        <Button x:Name="btnStop" Content="停止系统" Margin="5" Padding="5"/>
                        <Button x:Name="btnReset" Content="系统复位" Margin="5" Padding="5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            
            <!-- 右侧显示区域 -->
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>
                
                <!-- 实时数据显示 -->
                <DataGrid Grid.Row="0" x:Name="dataGridRealTime" AutoGenerateColumns="False" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="150"/>
                        <DataGridTextColumn Header="数据点" Binding="{Binding DataPoint}" Width="100"/>
                        <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="100"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- 状态日志 -->
                <GroupBox Grid.Row="1" Header="系统日志" Margin="5">
                    <TextBox x:Name="tbLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                             TextWrapping="Wrap" AcceptsReturn="True"/>
                </GroupBox>
            </Grid>
        </Grid>
        
        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="LightGray">
            <StatusBarItem>
                <TextBlock x:Name="statusBarText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>